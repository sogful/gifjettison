{
  "manifest_version": 3,
  "name": "GifJettison",
  "version": "1.0",
  "description": "hide gif comments under youtube videos!",
  "author": "cv",
  "homepage_url": "https://coolsite.cv",
  "permissions": [
    "storage"
  ],
  "action": {
    "default_title": "GifJettison",
    "default_popup": "popup.html"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "gifjettison@cv",
      "strict_min_version": "128.0"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["settings.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://www.youtube.com/*"],
      "css": ["content.css"],
      "js": ["content.js"],
      "world": "MAIN",
      "run_at": "document_start"
    }
  ]
}
